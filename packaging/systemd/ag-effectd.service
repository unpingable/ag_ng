[Unit]
Description=Agent Governor NG privileged exact-effect broker
Documentation=file:/usr/share/doc/agent-governor-ng/architecture.md
After=local-fs.target dbus.service
Before=agd.service
ConditionPathExists=/etc/agent-governor/effectd.toml
ConditionPathIsDirectory=/run/agent-governor/effectd/proposal
ConditionPathIsDirectory=/run/agent-governor/effectd/admin

[Service]
# The current binary does not implement sd_notify or watchdog heartbeats.
Type=exec
User=root
Group=root
SupplementaryGroups=
ExecStartPre=/usr/bin/ag-effectd --config /etc/agent-governor/effectd.toml --check-config
ExecStart=/usr/bin/ag-effectd --config /etc/agent-governor/effectd.toml
LoadCredentialEncrypted=rpc-ed25519-pkcs8:/etc/credstore.encrypted/effectd-rpc-ed25519-pkcs8.cred
Restart=on-failure
RestartSec=2s
KillMode=control-group
OOMPolicy=stop
StateDirectory=agent-governor/effectd
StateDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ag-effectd

NoNewPrivileges=yes
# The base capability set serves managed-file-only catalogs. A deployment with
# a managed-pointer target must install the exact target-derived drop-in in the
# packaging README, adding only SETUID/SETGID so the fixed Git child can enter
# the enrolled target owner. Live readiness refuses either missing or excess
# capabilities. Effectd never receives ptrace, network, mount, sys_admin, or a
# generic execution capability.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
AmbientCapabilities=
DevicePolicy=closed
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/run
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
PrivateMounts=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
TasksMax=128

# Every admitted target root must be repeated in a root-owned local drop-in.
# The live process requires exact equality with the complete configured set;
# optional, missing, redundant-unconfigured, or broad paths refuse readiness.
ReadWritePaths=/var/lib/agent-governor/effectd
ReadWritePaths=/var/lib/agent-governor/effectd/objects
ReadWritePaths=/run/agent-governor/effectd/proposal
ReadWritePaths=/run/agent-governor/effectd/admin

[Install]
WantedBy=multi-user.target
