[Unit]
Description=Agent Governor NG admitted check helper %i
After=ag-effectd.service
BindsTo=ag-effectd.service
ConditionPathExists=/usr/libexec/agent-governor/ag-check-helper

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/libexec/agent-governor/ag-check-helper %i
TimeoutStartSec=1h
RuntimeDirectory=agent-governor/check/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ag-check-%i

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
PrivateDevices=yes
PrivateIPC=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @keyring @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=1024
TasksMax=256
MemoryMax=8G
CPUQuota=400%
