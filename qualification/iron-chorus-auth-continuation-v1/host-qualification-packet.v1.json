      "authority": "protected read-only operator approval",
      "argv": ["sudo", "-n", "systemctl", "show", "--property=User,Group,ExecStart,FragmentPath", "ag-external-authorizer.service"],
      "expected": {
        "exit_status": 0,
        "stdout_required_keys": ["User", "Group", "ExecStart", "FragmentPath"],
