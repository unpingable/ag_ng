  "cases": [
    {
      "id": "userns-map-root",
      "authority": "unprivileged local qualification",
      "argv": ["unshare", "--user", "--map-root-user", "/usr/bin/id", "-u"],
      "expected": {
        "exit_status": 0,
        "stdout_exact": "0\n",
        "stderr_exact": ""
      },
      "unsupported_when": "the kernel or host policy refuses creation of an unprivileged user namespace",
      "unsupported_classification": "host_unsupported"
    },
    {
      "id": "bubblewrap-read-only-root",
      "authority": "unprivileged local qualification",
      "argv": ["bwrap", "--unshare-user", "--uid", "0", "--gid", "0", "--ro-bind", "/", "/", "/usr/bin/true"],
      "expected": {
        "exit_status": 0,
        "stdout_exact": "",
        "stderr_exact": ""
      },
      "unsupported_when": "bubblewrap is absent or the host permission boundary refuses its user namespace",
      "unsupported_classification": "host_unsupported"
    },
    {
      "id": "root-authorization-custody-metadata",
      "authority": "protected read-only operator approval",
      "argv": ["sudo", "-n", "stat", "-Lc", "%F %a %u %g", "/var/lib/ag-external-authorizer"],
      "expected": {
        "exit_status": 0,
        "stdout_pattern": "^directory 700 [0-9]+ [0-9]+\n$",
        "interpretation": "the durable daemon custody root is a real mode-0700 directory owned by the configured service identity"
